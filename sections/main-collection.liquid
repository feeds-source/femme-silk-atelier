{% assign handle = collection.handle | default: 'all' %}
{% assign hero_img = 'lounge.jpg' %}
{% assign hero_vid = '' %}
{% assign hero_kick = 'Boutique' %}
{% assign hero_body = 'Night, body, and after dusk — jewel silk, lace, and gold, cut for 30B–42C.' %}
{% case handle %}
  {% when 'bras' %}
    {% assign hero_img = 'everyday-soft-bra.jpg' %}{% assign hero_vid = 'everyday-soft-bra.mp4' %}{% assign hero_kick = 'Body' %}{% assign hero_body = 'Soft cups, T-shirt, first-fit. Band and cup as worn in atelier fittings.' %}
  {% when 'bra-sets' %}
    {% assign hero_img = 'lace-balconette-set.jpg' %}{% assign hero_vid = 'lace-balconette-set.mp4' %}{% assign hero_kick = 'Body' %}{% assign hero_body = 'Balconette pairs. Midnight lace with a matching brief.' %}
  {% when 'babydoll' %}
    {% assign hero_img = 'ruby-babydoll.jpg' %}{% assign hero_vid = 'ruby-babydoll.mp4' %}{% assign hero_kick = 'Night' %}{% assign hero_body = 'Short lace night. Ruby, orchid, noir — hem above the knee.' %}
  {% when 'gowns' %}
    {% assign hero_img = 'satin-gown.jpg' %}{% assign hero_kick = 'Night' %}{% assign hero_body = 'Floor-length satin. Between sizes at the hip — take the larger.' %}
  {% when 'teddies' %}
    {% assign hero_img = 'noir-teddy.jpg' %}{% assign hero_vid = 'noir-teddy.mp4' %}{% assign hero_kick = 'Night' %}{% assign hero_body = 'One-piece lace and jewel silk, cut for candlelight.' %}
  {% when 'bridal' %}
    {% assign hero_img = 'ivory-bridal-set.jpg' %}{% assign hero_vid = 'ivory-bridal-set.mp4' %}{% assign hero_kick = 'After dusk' %}{% assign hero_body = 'Ivory lace, pearl clasps, getting-ready robes.' %}
  {% when 'corsetry' %}
    {% assign hero_img = 'emerald-bustier.jpg' %}{% assign hero_vid = 'emerald-bustier.mp4' %}{% assign hero_kick = 'Body' %}{% assign hero_body = 'Boning and gold. Hourglass, not squeeze — lace 4–6 cm.' %}
  {% when 'swim' %}
    {% assign hero_img = 'silk-bikini.jpg' %}{% assign hero_kick = 'After dusk' %}{% assign hero_body = 'Jewel bikini. Triangle top to the nearest cup, brief to the hip.' %}
  {% when 'body-stockings' %}
    {% assign hero_img = 'body-stocking.jpg' %}{% assign hero_kick = 'Body' %}{% assign hero_body = 'Sheer noir lace, one piece. Free size, made to drape.' %}
  {% when 'bralettes' %}
    {% assign hero_img = 'cloud-bralette.jpg' %}{% assign hero_kick = 'Body' %}{% assign hero_body = 'Wireless bralettes. The comfort bra US wardrobes wear all day.' %}
  {% when 'seamless' %}
    {% assign hero_img = 'invisible-brief.jpg' %}{% assign hero_kick = 'Body' %}{% assign hero_body = 'Bonded, no-show briefs and thongs. Nothing to read under clothes.' %}
  {% when 'sleep-sets' %}
    {% assign hero_img = 'champagne-sleep-set.jpg' %}{% assign hero_kick = 'Night' %}{% assign hero_body = 'Silk shirt and wide trouser. Sleep sets, the fastest lounge aisle.' %}
  {% when 'slips' %}
    {% assign hero_img = 'atelier-slip.jpg' %}{% assign hero_kick = 'Night' %}{% assign hero_body = 'Half slips for dresses, and slip dresses in their own right.' %}
  {% when 'leakproof' %}
    {% assign hero_img = 'silk-leakproof.jpg' %}{% assign hero_kick = 'Body' %}{% assign hero_body = 'Stay-dry gusset briefs for cycle days. Same fit as the house brief.' %}
  {% when 'active' %}
    {% assign hero_img = 'studio-bra.jpg' %}{% assign hero_kick = 'Body' %}{% assign hero_body = 'Wireless studio bras. Light support from the house to the street.' %}
  {% when 'robes' %}
    {% assign hero_img = 'noir-robe.jpg' %}{% assign hero_kick = 'After dusk' %}{% assign hero_body = 'Self-tie robes. Lounge that leaves the house.' %}
  {% when 'loungewear' %}
    {% assign hero_img = 'lounge.jpg' %}{% assign hero_kick = 'After dusk' %}{% assign hero_body = 'Knit robes and wide-leg ease. Emerald after dusk.' %}
{% endcase %}
{% if hero_vid == blank %}
  {% assign hero_vid = hero_img | replace: '.jpg', '.mp4' %}
{% endif %}

<section class="page-hero">
  {% if collection.featured_image %}
    {{ collection.featured_image | image_url: width: 2000 | image_tag: class: 'ken', loading: 'eager', alt: collection.title }}
  {% else %}
    <img class="ken" src="{{ hero_img | asset_url }}" alt="" width="1600" height="1000" loading="eager">
  {% endif %}
  {% if hero_vid != blank %}
    <video class="motion-video" autoplay muted loop playsinline poster="{{ hero_img | asset_url }}" aria-hidden="true">
      <source src="{{ hero_vid | asset_url }}" type="video/mp4">
    </video>
  {% endif %}
  <div class="hero-veil"></div>
  <div class="wrap page-hero-copy">
    <p class="kicker">{{ hero_kick }}</p>
    <h1 class="display page-title">{{ collection.title | default: 'Shop the house' }}</h1>
    <p class="muted lede">{{ collection.description | default: hero_body }}</p>
  </div>
</section>

{% if handle == 'all' or handle == 'frontpage' or handle == blank %}
<section class="wrap section">
  <p class="kicker">Aisles</p>
  <h2 class="display" style="font-style:italic">Walk the house</h2>
  <div class="grid-aisles">
    {% assign walk = "Bralettes|Wireless all day|cloud-bralette.jpg,Seamless|Nothing to show|invisible-brief.jpg,Sleep Sets|Matching sleep|champagne-sleep-set.jpg,Bra Sets|Balconette pairs|lace-balconette-set.jpg,Gowns|Satin after dusk|satin-gown.jpg,Swim|Jewel bikini|silk-bikini.jpg,Corsetry|Boning and gold|emerald-bustier.jpg,Body Stockings|Sheer noir|body-stocking.jpg" | split: "," %}
    {% for row in walk %}
      {% assign bit = row | split: "|" %}
      <a class="aisle group" href="{{ routes.search_url }}?type=product&q={{ bit[0] | url_encode }}">
        <img class="ken" src="{{ bit[2] | asset_url }}" alt="{{ bit[0] | escape }}" width="800" height="600">
        <video class="motion-video" autoplay muted loop playsinline poster="{{ bit[2] | asset_url }}" aria-hidden="true">
          <source src="{{ bit[2] | replace: '.jpg', '.mp4' | asset_url }}" type="video/mp4">
        </video>
        <div class="hero-veil"></div>
        <div class="aisle__copy"><p class="kicker">{{ bit[0] }}</p><h3>{{ bit[1] }}</h3></div>
      </a>
    {% endfor %}
  </div>
</section>
{% endif %}

{% for block in section.blocks %}
  {% if block.type == '@app' %}
    <div class="wrap" style="margin-top:1.5rem">{% render block %}</div>
  {% endif %}
{% endfor %}

<nav class="guide-nav">
  <div class="wrap filters">
    <a class="pill {% if handle == 'all' %}is-on{% endif %}" href="{{ routes.all_products_collection_url }}">All</a>
    {% assign femme_cats = 'Bras,Bralettes,Seamless,Sleep Sets,Slips,Leakproof,Active,Robes,Bra Sets,Panties,Camisole,Babydoll,Short Nighty,Long Nighty,Gowns,Teddies,Bridal,Corsetry,Hosiery,Body Stockings,Shapewear,Swim,Loungewear,Resort,Thermal,Accessories' | split: ',' %}
    {% for c in femme_cats %}
      <a class="pill {% if collection.title == c %}is-on{% endif %}" href="{{ routes.search_url }}?type=product&q={{ c | url_encode }}">{{ c }}</a>
    {% endfor %}
  </div>
</nav>

{% paginate collection.products by 24 %}
<div class="wrap section">
  <div class="catalog-head">
    <p class="muted">
      {% if collection.products_count > 0 %}
        {{ collection.products_count }} {{ collection.products_count | pluralize: 'piece', 'pieces' }}
      {% else %}
        House catalog · prices in USD
      {% endif %}
    </p>
    <a class="gold" href="{{ pages['size-guide'].url | default: '/pages/size-guide' }}">Size charts</a>
  </div>
  <div class="grid-shop" style="margin-top:2rem">
    {% for product in collection.products %}
      {% render 'product-card', product: product %}
    {% else %}
      {% render 'demo-catalog', mode: handle, max_items: 60 %}
    {% endfor %}
  </div>
  {% if paginate.pages > 1 %}
    <div class="filters" style="margin-top:2rem">{{ paginate | default_pagination }}</div>
  {% endif %}
</div>
{% endpaginate %}

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "class": "section",
  "blocks": [{ "type": "@app" }],
  "settings": []
}
{% endschema %}
