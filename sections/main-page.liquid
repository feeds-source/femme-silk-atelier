{% if page.handle == 'size-guide' or page.handle == 'sizes' or page.handle == 'size-charts' or page.handle == 'size-chart' %}
  {% render 'size-guide-content' %}
{% elsif page.handle == 'the-atelier' or page.handle == 'atelier' or page.handle == 'about' or page.handle == 'about-us' %}
  {% render 'atelier-house-content' %}
{% elsif page.handle == 'contact' or page.handle == 'contact-us' %}
  {% render 'contact-content' %}
{% else %}
  <section class="page-hero cine-page">
    <img class="ken" src="{{ 'hero.jpg' | asset_url }}" alt="{{ page.title | escape }}" width="1600" height="1000" loading="eager">
    <div class="hero-veil"></div>
    <div class="wrap page-hero-copy">
      <p class="kicker">House</p>
      <h1 class="display page-title" style="font-style:italic">{{ page.title }}</h1>
    </div>
  </section>

  <div class="wrap section" style="max-width:48rem">
    <div class="muted" style="line-height:1.8;font-size:1.05rem">{{ page.content }}</div>
    {% for block in section.blocks %}
      {% if block.type == '@app' %}
        <div style="margin-top:2rem">
          {% render block %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": []
}
{% endschema %}
