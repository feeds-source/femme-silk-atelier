{% if settings.show_announcement and settings.announcement_text != blank %}
  <div class="announcement-bar" role="region" aria-label="Announcement">
    <div class="wrap announcement-bar__inner">
      {% if settings.announcement_link != blank %}
        <a href="{{ settings.announcement_link }}" class="announcement-bar__link">
          {{ settings.announcement_text }}
        </a>
      {% else %}
        <span>{{ settings.announcement_text }}</span>
      {% endif %}
    </div>
  </div>
{% endif %}

<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="brand" href="{{ routes.root_url }}">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 300 | image_tag: class: 'brand__logo', alt: shop.name }}
      {% else %}
        <span class="brand__name">{{ settings.brand_name | default: 'FEMME' }}</span>
        <span class="brand__sub">{{ settings.brand_sub | default: 'Silk Atelier' }}</span>
      {% endif %}
    </a>

    {% assign menu_links = linklists[section.settings.menu].links %}
    <nav class="nav-desk" aria-label="Primary">
      {% if menu_links.size > 0 %}
        {% for link in menu_links %}
          {% if link.links.size > 0 %}
            <div class="nav-dropdown" style="position:relative;display:inline-flex;align-items:center">
              <a href="{{ link.url }}" class="{% if link.active %}is-on{% endif %}">{{ link.title }} ▾</a>
              <div class="nav-dropdown-menu" style="display:none;position:absolute;top:100%;left:0;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:0.5rem 0;min-width:12rem;z-index:40;box-shadow:0 10px 25px rgba(0,0,0,0.5)">
                {% for child_link in link.links %}
                  <a href="{{ child_link.url }}" style="display:block;padding:0.5rem 1rem;font-size:0.75rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--muted)">
                    {{ child_link.title }}
                  </a>
                {% endfor %}
              </div>
            </div>
          {% else %}
            <a href="{{ link.url }}" class="{% if link.active %}is-on{% endif %}">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}" class="{% if request.page_type == 'index' %}is-on{% endif %}">Home</a>
        <a href="{{ routes.all_products_collection_url }}" class="{% if request.page_type == 'collection' or request.page_type == 'product' %}is-on{% endif %}">Shop</a>
        <a href="{{ pages['size-guide'].url | default: '/pages/size-guide' }}" class="{% if page.handle == 'size-guide' %}is-on{% endif %}">Sizes</a>
        <a href="{{ pages.atelier.url | default: pages['the-atelier'].url | default: pages.about.url | default: '/pages/atelier' }}" class="{% if page.handle == 'atelier' or page.handle == 'the-atelier' or page.handle == 'about' %}is-on{% endif %}">Atelier</a>
        <a href="{{ pages.contact.url | default: '/pages/contact' }}" class="{% if page.handle == 'contact' %}is-on{% endif %}">Contact</a>
      {% endif %}
    </nav>

    <div class="header-actions">
      <button type="button" class="pill search-pill" data-search-open aria-label="Search the atelier">
        <span aria-hidden="true">🔍</span> Search
      </button>

      {% if shop.customer_accounts_enabled %}
        <a class="pill" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
          {% if customer %}Account{% else %}Sign in{% endif %}
        </a>
      {% endif %}

      <a class="pill bag-pill" href="{{ routes.cart_url }}" data-cart-trigger>
        Bag <span data-cart-count>{{ cart.item_count }}</span>
      </a>

      <button type="button" class="menu-btn" data-menu aria-expanded="false" aria-label="Menu">☰</button>
    </div>
  </div>

  <nav class="nav-mob" data-nav-mob>
    {% if menu_links.size > 0 %}
      {% for link in menu_links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
        {% if link.links.size > 0 %}
          {% for child in link.links %}
            <a href="{{ child.url }}" style="padding-left:1.5rem;font-size:0.85rem;color:var(--muted)">↳ {{ child.title }}</a>
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% else %}
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <a href="{{ pages['size-guide'].url | default: '/pages/size-guide' }}">Sizes</a>
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' or collection.all_products_count == 0 %}
          <a href="{{ collection.url }}">{{ collection.title }}</a>
        {% endunless %}
      {% endfor %}
      <a href="{{ pages.atelier.url | default: pages.about.url | default: '/pages/atelier' }}">Atelier</a>
      <a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact</a>
    {% endif %}
  </nav>

  {% render 'predictive-search' %}
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
