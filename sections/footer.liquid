<footer class="site-footer">
  <img src="{{ 'lounge.jpg' | asset_url }}" alt="" width="1600" height="1000" loading="lazy">
  <div class="footer-veil"></div>
  <div class="wrap site-footer__inner">
    <div class="grid-footer">
      <div class="brand-lockup">
        <p class="brand__name">{{ settings.brand_name | default: 'FEMME' }}</p>
        <p class="brand__sub">{{ settings.brand_sub | default: 'Silk Atelier' }}</p>
        <h2>{{ settings.brand_line | default: 'Exotic silk, cut for the body.' }}</h2>
        <p class="muted" style="margin-top:1rem;max-width:24rem;line-height:1.6">
          An adult house of jewel lingerie, moonlit sleepwear, and evening lounge. Complimentary discreet packaging and cash on delivery worldwide.
        </p>

        <div class="footer-newsletter" style="margin-top:1.75rem;max-width:24rem">
          <p class="subtle" style="font-size:0.75rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--accent)">Private Salon Invitation</p>
          {% form 'customer', id: 'FooterNewsletterForm' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div style="display:flex;gap:0.5rem;margin-top:0.5rem">
              <input
                type="email"
                name="contact[email]"
                required
                placeholder="Enter email for private drops"
                style="flex:1;height:2.6rem;padding:0 1rem;border:1px solid var(--line);border-radius:999px;background:var(--elevated);color:var(--fg);font-size:0.85rem"
              >
              <button class="pill is-on" type="submit" style="white-space:nowrap;padding:0 1.25rem">Join</button>
            </div>
            {% if form.posted_successfully? %}
              <p class="gold" style="font-size:0.8rem;margin-top:0.5rem">✓ Welcome to the private atelier circle.</p>
            {% endif %}
          {% endform %}
        </div>

        {% if settings.social_instagram_link != blank or settings.social_pinterest_link != blank or settings.social_tiktok_link != blank or settings.social_facebook_link != blank %}
          <div class="footer-socials" style="display:flex;gap:1rem;margin-top:1.5rem">
            {% if settings.social_instagram_link != blank %}
              <a class="subtle" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer">Instagram</a>
            {% endif %}
            {% if settings.social_pinterest_link != blank %}
              <a class="subtle" href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener noreferrer">Pinterest</a>
            {% endif %}
            {% if settings.social_tiktok_link != blank %}
              <a class="subtle" href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener noreferrer">TikTok</a>
            {% endif %}
            {% if settings.social_facebook_link != blank %}
              <a class="subtle" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer">Facebook</a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="grid-footer-nav">
        <div>
          <h3>Sleep Room</h3>
          <ul>
            <li><a href="{{ collections.babydoll.url | default: '/collections/sleep' }}">Babydoll</a></li>
            <li><a href="{{ collections['short-nighty'].url | default: '/collections/sleep' }}">Short Nighty</a></li>
            <li><a href="{{ collections['long-nighty'].url | default: '/collections/sleep' }}">Long Nighty</a></li>
            <li><a href="{{ collections.gowns.url | default: '/collections/sleep' }}">Gowns</a></li>
            <li><a href="{{ collections.teddies.url | default: '/collections/sleep' }}">Teddies</a></li>
          </ul>
        </div>
        <div>
          <h3>Body Room</h3>
          <ul>
            <li><a href="{{ collections.bras.url | default: '/collections/lingerie' }}">Bras</a></li>
            <li><a href="{{ collections['bra-sets'].url | default: '/collections/lingerie' }}">Bra Sets</a></li>
            <li><a href="{{ collections.panties.url | default: '/collections/lingerie' }}">Panties</a></li>
            <li><a href="{{ collections.camisole.url | default: '/collections/lingerie' }}">Camisole</a></li>
            <li><a href="{{ collections.corsetry.url | default: '/collections/lingerie' }}">Corsetry</a></li>
            <li><a href="{{ collections.hosiery.url | default: '/collections/lingerie' }}">Hosiery</a></li>
            <li><a href="{{ collections['body-stockings'].url | default: '/collections/lingerie' }}">Body Stockings</a></li>
          </ul>
        </div>
        <div>
          <h3>Lounge Room</h3>
          <ul>
            <li><a href="{{ collections.bridal.url | default: '/collections/lounge' }}">Bridal Suite</a></li>
            <li><a href="{{ collections.swim.url | default: '/collections/lounge' }}">Silk Swim</a></li>
            <li><a href="{{ collections.loungewear.url | default: '/collections/lounge' }}">Loungewear</a></li>
            <li><a href="{{ collections.resort.url | default: '/collections/lounge' }}">Resort Robes</a></li>
            <li><a href="{{ collections.thermal.url | default: '/collections/lounge' }}">Thermal Silk</a></li>
          </ul>
        </div>
        <div>
          <h3>House</h3>
          <ul>
            <li><a href="{{ pages['the-atelier'].url | default: pages.atelier.url | default: '/pages/the-atelier' }}">The Atelier</a></li>
            <li><a href="{{ pages['size-guide'].url | default: '/pages/size-guide' }}">Size Guide & Fit Studio</a></li>
            <li><a href="{{ pages.contact.url | default: '/pages/contact' }}">Concierge Contact</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Shop All Collections</a></li>
            <li><a href="{{ routes.account_url }}">Client Orders</a></li>
          </ul>
          <p class="subtle" style="margin-top:1.5rem;font-size:0.7rem;letter-spacing:0.18em;text-transform:uppercase">Write to Salon</p>
          <a class="gold" href="mailto:{{ settings.contact_email | default: 'info@silkmoments.com' }}">{{ settings.contact_email | default: 'info@silkmoments.com' }}</a>
        </div>
      </div>
    </div>

    <div class="gold-rule" style="margin-top:3.5rem"></div>

    <div class="legal" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1.5rem">
      <div>
        <p>{{ 'general.cod' | t | default: 'Cash on delivery worldwide' }} · {{ 'general.sizes' | t | default: 'Complimentary size exchange' }} · Discreet luxury presentation</p>
        <p style="margin-top:0.25rem">© {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ powered_by_link }}</p>
      </div>

      {% render 'localization-selector' %}

      {% if settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
        <div class="footer-payment-icons" style="display:flex;gap:0.5rem;flex-wrap:wrap">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
