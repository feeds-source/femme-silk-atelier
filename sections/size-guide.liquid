{% render 'size-guide-content' %}

{% schema %}
{
  "name": "Size guide",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Atelier fittings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Size charts and fit studio"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Description",
      "default": "Find your precise measurements from the tape, then explore the house maps — bra cups, body ranges, corset reduction, hosiery, and silk gowns."
    },
    {
      "type": "checkbox",
      "id": "show_print_button",
      "label": "Show print charts button",
      "default": true
    }
  ],
  "presets": [{ "name": "Size guide" }]
}
{% endschema %}
