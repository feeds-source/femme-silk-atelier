<section class="section">
  <div class="wrap">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap">
      <div>
        <p class="kicker">{{ section.settings.kicker }}</p>
        <h2>{{ section.settings.title }}</h2>
      </div>
      {% assign target_coll = collections[section.settings.collection] | default: section.settings.collection | default: collections.all %}
      <a class="gold" href="{{ target_coll.url | default: routes.all_products_collection_url }}">{{ 'general.view_all' | t | default: 'View all pieces' }}</a>
    </div>
    <div class="grid-bento">
      {% assign shown = 0 %}
      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: section.settings.limit %}
          {% render 'product-card', product: product %}
          {% assign shown = shown | plus: 1 %}
        {% endfor %}
      {% endif %}
      {% if shown == 0 and collections.all.products.size > 0 %}
        {% for product in collections.all.products limit: section.settings.limit %}
          {% render 'product-card', product: product %}
          {% assign shown = shown | plus: 1 %}
        {% endfor %}
      {% endif %}
      {% if shown == 0 %}
        {% assign demo_cap = section.settings.limit %}
        {% render 'demo-catalog', mode: 'featured', max_items: demo_cap %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured bento",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The Collection" },
    { "type": "text", "id": "title", "label": "Title", "default": "House Highlights" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 3, "max": 12, "step": 1, "label": "Products", "default": 9 }
  ],
  "presets": [{ "name": "Featured bento" }]
}
{% endschema %}
