<section class="wrap section">
  <p class="kicker">Journal</p>
  <h1 class="display" style="font-style:italic">{{ blog.title }}</h1>
  
  {% paginate blog.articles by 12 %}
    <div class="grid-shop" style="margin-top:2rem">
      {% for article in blog.articles %}
        <article class="product-tile">
          <a href="{{ article.url }}">
            <div class="card-media">
              {% if article.image %}
                {{ article.image | image_url: width: 900 | image_tag: class: 'ken', alt: article.title, loading: 'lazy' }}
              {% else %}
                <div style="background:var(--elevated);width:100%;height:100%;min-height:14rem"></div>
              {% endif %}
            </div>
            <div class="card-body">
              <p class="cat">{{ article.published_at | date: '%d %b %Y' }}</p>
              <h3>{{ article.title }}</h3>
              <p class="muted" style="font-size:0.85rem;margin-top:0.4rem">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
            </div>
          </a>
        </article>
      {% else %}
        <p class="muted">No journal entries yet.</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <div class="filters" style="margin-top:2rem">{{ paginate | default_pagination }}</div>
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
