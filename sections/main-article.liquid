<article class="wrap section" style="max-width:44rem">
  <p class="kicker">{{ article.published_at | date: '%d %b %Y' }}</p>
  <h1 class="display" style="font-style:italic;margin-top:0.5rem">{{ article.title }}</h1>

  {% if article.image %}
    <div class="product__media" style="position:relative;min-height:20rem;margin-top:1.5rem">
      {{ article.image | image_url: width: 1400 | image_tag: class: 'ken', alt: article.title, loading: 'eager' }}
    </div>
  {% endif %}

  <div class="muted" style="margin-top:2rem;line-height:1.7;font-size:1.05rem">
    {{ article.content }}
  </div>

  {% if blog.comments_enabled? %}
    <div class="article-comments" style="margin-top:4rem;border-top:1px solid var(--line);padding-top:2rem">
      <h2 class="display" style="font-style:italic">Thoughts & notes ({{ article.comments_count }})</h2>

      {% paginate article.comments by 10 %}
        {% if article.comments_count > 0 %}
          <div style="display:grid;gap:1.5rem;margin-top:1.5rem">
            {% for comment in article.comments %}
              <div style="padding:1rem 1.25rem;background:var(--surface);border:1px solid var(--line);border-radius:1rem">
                <div style="display:flex;justify-content:space-between;align-items:center">
                  <strong class="gold">{{ comment.author }}</strong>
                  <span class="subtle" style="font-size:0.75rem">{{ comment.created_at | date: '%d %b %Y' }}</span>
                </div>
                <div class="muted" style="margin-top:0.5rem;font-size:0.9rem">
                  {{ comment.content }}
                </div>
              </div>
            {% endfor %}
          </div>
          {% if paginate.pages > 1 %}
            <div class="filters" style="margin-top:1.5rem">{{ paginate | default_pagination }}</div>
          {% endif %}
        {% endif %}
      {% endpaginate %}

      <div style="margin-top:2.5rem;padding:2rem;background:var(--surface);border:1px solid var(--line);border-radius:1.25rem">
        <h3 class="display" style="font-style:italic">Leave a note</h3>
        
        {% form 'new_comment', article %}
          {% if form.posted_successfully? %}
            <p class="gold" style="margin-top:1rem">✓ Thank you. Your note has been posted to the atelier journal.</p>
          {% elsif form.errors %}
            <p class="subtle" style="color:var(--blush);margin-top:1rem">
              {{ form.errors | default_errors }}
            </p>
          {% endif %}

          <div style="display:grid;gap:1rem;margin-top:1rem">
            <div>
              <label class="kicker" for="Comment-Author">Name *</label>
              <input
                id="Comment-Author"
                type="text"
                name="comment[author]"
                value="{{ form.author }}"
                required
                style="width:100%;height:2.75rem;padding:0 0.9rem;border:1px solid var(--line);border-radius:999px;background:var(--elevated);color:var(--fg);margin-top:0.25rem"
              >
            </div>
            <div>
              <label class="kicker" for="Comment-Email">Email *</label>
              <input
                id="Comment-Email"
                type="email"
                name="comment[email]"
                value="{{ form.email }}"
                required
                style="width:100%;height:2.75rem;padding:0 0.9rem;border:1px solid var(--line);border-radius:999px;background:var(--elevated);color:var(--fg);margin-top:0.25rem"
              >
            </div>
            <div>
              <label class="kicker" for="Comment-Body">Note *</label>
              <textarea
                id="Comment-Body"
                name="comment[body]"
                rows="4"
                required
                style="width:100%;padding:0.75rem 0.9rem;border:1px solid var(--line);border-radius:0.75rem;background:var(--elevated);color:var(--fg);margin-top:0.25rem;font-family:inherit"
              >{{ form.body }}</textarea>
            </div>
            <button class="btn" type="submit" style="width:fit-content;margin-top:0.5rem">Post note</button>
          </div>
        {% endform %}
      </div>
    </div>
  {% endif %}
</article>

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
