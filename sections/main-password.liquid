{% assign kicker = section.settings.kicker | default: 'Night atelier' %}
{% assign title = section.settings.title | default: 'The salon is preparing.' %}
{% assign subtext = section.settings.subtext | default: 'Exotic silk, cut for the body. Jewel-tone lounge, sleep, and lingerie. The house will open soon for private viewings.' %}

<div class="password-page-wrap" style="position:relative;min-height:100vh;display:flex;flex-direction:column;justify-content:space-between;background:var(--bg);color:var(--fg);overflow:hidden">
  <div style="position:absolute;inset:0;z-index:1">
    <img src="{{ 'hero.jpg' | asset_url }}" alt="Atelier" width="1920" height="1080" style="width:100%;height:100%;object-fit:cover;opacity:0.35">
    <div class="hero-veil" style="position:absolute;inset:0;background:radial-gradient(ellipse at center, rgba(12,10,11,0.6) 0%, rgba(12,10,11,0.95) 100%)"></div>
  </div>

  <header class="wrap" style="position:relative;z-index:2;padding:2rem 1rem;display:flex;justify-content:space-between;align-items:center">
    <div class="brand">
      <span class="brand__name">{{ settings.brand_name | default: 'FEMME' }}</span>
      <span class="brand__sub">{{ settings.brand_sub | default: 'Silk Atelier' }}</span>
    </div>

    <button
      type="button"
      class="pill"
      onclick="document.getElementById('PasswordModal').toggleAttribute('hidden')"
      style="cursor:pointer"
    >
      🔒 Store login
    </button>
  </header>

  <main class="wrap" style="position:relative;z-index:2;max-width:38rem;text-align:center;padding:3rem 1rem">
    <p class="kicker">{{ kicker }}</p>
    <h1 class="display" style="font-size:clamp(2.2rem, 5vw, 3.8rem);font-style:italic;margin-top:0.75rem;line-height:1.15">
      {{ title }}
    </h1>
    <p class="muted lede" style="margin-top:1.25rem;line-height:1.6">
      {{ subtext }}
    </p>

    {% if section.settings.show_newsletter %}
      <div style="margin-top:2.5rem;padding:2rem;background:var(--surface);border:1px solid var(--line);border-radius:1.5rem;box-shadow:0 15px 35px rgba(0,0,0,0.5)">
        <p class="kicker">{{ section.settings.newsletter_kicker | default: 'Private invitations' }}</p>
        <h3 class="display" style="font-style:italic;margin-top:0.25rem">
          {{ section.settings.newsletter_heading | default: 'Be invited to the opening' }}
        </h3>

        {% form 'customer', class: 'newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter, salon_invitation">
          {% if form.posted_successfully? %}
            <p class="gold" style="margin-top:1rem">✓ Your invitation has been reserved. You will be notified when the doors open.</p>
          {% elsif form.errors %}
            <p class="subtle" style="color:var(--blush);margin-top:1rem">{{ form.errors | default_errors }}</p>
          {% endif %}

          <div style="display:flex;gap:0.5rem;margin-top:1.25rem;flex-wrap:wrap;justify-content:center">
            <input
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="Enter your email"
              required
              style="flex:1;min-width:14rem;height:3rem;padding:0 1.25rem;border:1px solid var(--line);border-radius:999px;background:var(--elevated);color:var(--fg)"
            >
            <button class="btn" type="submit" style="height:3rem">Request access</button>
          </div>
        {% endform %}
      </div>
    {% endif %}

    <div id="PasswordModal" hidden style="margin-top:2rem;padding:1.5rem;background:var(--surface);border:1px solid var(--line);border-radius:1rem">
      <p class="kicker">House access</p>
      <h3 style="margin-top:0.25rem">Enter store password</h3>
      {% form 'storefront_password' %}
        {% if form.errors %}
          <p class="subtle" style="color:var(--blush);margin:0.5rem 0">{{ form.errors | default_errors }}</p>
        {% endif %}
        <div style="display:flex;gap:0.5rem;margin-top:1rem;justify-content:center;flex-wrap:wrap">
          <input
            id="PasswordModal-input"
            type="password"
            name="password"
            placeholder="Password"
            required
            style="flex:1;min-width:12rem;height:2.75rem;padding:0 1rem;border:1px solid var(--line);border-radius:999px;background:var(--elevated);color:var(--fg)"
          >
          <button class="btn" type="submit">Enter</button>
        </div>
      {% endform %}
    </div>
  </main>

  <footer class="wrap" style="position:relative;z-index:2;padding:2rem 1rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem">
    <p class="subtle" style="font-size:0.8rem">© {{ 'now' | date: '%Y' }} {% if shop.name == blank or shop.name == 'My Store' %}{{ settings.brand_name | default: 'FEMME' }} {{ settings.brand_sub | default: 'Silk Atelier' }}{% else %}{{ shop.name }}{% endif %}</p>
    <p class="subtle" style="font-size:0.8rem">Cash on delivery worldwide · Printable receipt with every piece</p>
  </footer>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Night atelier"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The salon is preparing."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Exotic silk, cut for the body. Jewel-tone lounge, sleep, and lingerie. The house will open soon for private viewings."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show invitation request form",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_kicker",
      "label": "Newsletter kicker",
      "default": "Private invitations"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Be invited to the opening"
    }
  ],
  "presets": [{ "name": "Password" }]
}
{% endschema %}
