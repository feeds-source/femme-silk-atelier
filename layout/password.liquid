<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ 'femme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="wrap section">
      <p class="kicker">Silk Atelier</p>
      <h1 class="display" style="font-style:italic">{{ shop.name }}</h1>
      {% form 'storefront_password' %}
        <input type="password" name="password" class="qty" placeholder="Password" style="width:100%;max-width:16rem;margin:1rem 0">
        <button class="btn" type="submit">Enter</button>
      {% endform %}
    </main>
  </body>
</html>
