<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>
      {%- if page.handle == 'the-atelier' or page.handle == 'atelier' or page.handle == 'about' -%}
        The Atelier — Femme Silk Moments | Jewel-Tone Silk Lingerie
      {%- elsif page.handle == 'size-guide' or page.handle == 'sizes' -%}
        Size Guide & Fit Studio — 30B–42C, XS–XXL | Femme Silk Moments
      {%- elsif page.handle == 'contact' -%}
        Atelier Concierge & Inquiries | Femme Silk Moments
      {%- else -%}
        {{ page_title }}
        {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
        {%- if current_page != 1 %} – Page {{ current_page }}{% endif -%}
        {%- unless page_title contains shop.name %} · {{ shop.name }}{% endunless -%}
      {%- endif -%}
    </title>
    <meta name="description" content="{%- if page_description != blank -%}{{ page_description | escape }}{%- elsif page.handle == 'the-atelier' or page.handle == 'atelier' or page.handle == 'about' -%}Femme is an adult house of jewel silk. Exotic silk lingerie, lounge, and nightwear cut for the body. Cash on delivery worldwide.{%- elsif page.handle == 'size-guide' or page.handle == 'sizes' -%}Explore the Femme Silk Atelier sizing matrix. Precise bra band and cup fittings from 30B to 42C, body ranges from XS to XXL, corset reductions, and hosiery charts.{%- elsif page.handle == 'contact' -%}Write to the Femme Silk Atelier. Inquiries on sizing, custom orders, and bespoke bridal consultations replied to within 12 hours.{%- else -%}{{ settings.brand_line | default: 'Exotic silk, cut for the body. Jewel-tone lounge, sleep, and lingerie. Cash on delivery worldwide.' | escape }}{%- endif -%}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" sizes="32x32">
    {%- endif -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,400;1,500;1,600&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet">
    {% render 'css-vars' %}
    {% render 'meta-tags' %}
    {{ 'femme.css' | asset_url | stylesheet_tag }}
    <script>
      window.FEMME = {
        searchUrl: {{ routes.search_url | json }},
        shopUrl: {{ routes.all_products_collection_url | json }},
        asset: function (name) {
          return {{ 'femme.css' | asset_url | json }}.replace(/femme\.css(\?.*)?$/, name);
        }
      };
    </script>
    {{ content_for_header }}
  </head>
  <body>
    <a class="visually-hidden" href="#MainContent">Skip to content</a>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    <script src="{{ 'femme.js' | asset_url }}" defer></script>
  </body>
</html>
