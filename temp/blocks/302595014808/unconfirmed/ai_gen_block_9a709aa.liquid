{% doc %}
  @prompt
    In the size guide section, the visual bar charts (cup volume bars, band bars, body range bars, corset reduction bars, hosiery bars, and gown length bars) are rendering without visible measurement labels or numbers next to them. Update the size guide bar and range chart elements so that each bar row clearly displays the corresponding measurement value (cm, inches, or size label) as a visible text label alongside or inside the bar, making the charts readable without additional context. The labels should match the luxury atelier aesthetic of the store — clean, minimal typography.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-size-guide-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 32px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-size-guide-{{ ai_gen_id }}__heading {
    margin: 0 0 8px;
    color: {{ block.settings.heading_color }};
    font-size: 24px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ai-size-guide-{{ ai_gen_id }}__intro {
    margin: 0 0 28px;
    color: {{ block.settings.muted_color }};
    font-size: 14px;
    line-height: 1.6;
  }

  .ai-size-guide-{{ ai_gen_id }}__charts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 40px;
  }

  .ai-size-guide-{{ ai_gen_id }}__chart {
    min-width: 0;
  }

  .ai-size-guide-{{ ai_gen_id }}__chart-title {
    margin: 0 0 14px;
    color: {{ block.settings.heading_color }};
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ai-size-guide-{{ ai_gen_id }}__row {
    display: grid;
    grid-template-columns: minmax(76px, 1fr) minmax(110px, 2fr) auto;
    align-items: center;
    gap: 12px;
    margin-bottom: 11px;
  }

  .ai-size-guide-{{ ai_gen_id }}__row-name,
  .ai-size-guide-{{ ai_gen_id }}__value {
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }

  .ai-size-guide-{{ ai_gen_id }}__row-name {
    color: {{ block.settings.muted_color }};
  }

  .ai-size-guide-{{ ai_gen_id }}__value {
    color: {{ block.settings.heading_color }};
    white-space: nowrap;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .ai-size-guide-{{ ai_gen_id }}__track {
    height: 8px;
    overflow: hidden;
    background: {{ block.settings.track_color }};
    border-radius: 99px;
  }

  .ai-size-guide-{{ ai_gen_id }}__fill {
    display: block;
    height: 100%;
    width: var(--bar-width);
    min-width: 4px;
    background: {{ block.settings.bar_color }};
    border-radius: inherit;
  }

  @media screen and (max-width: 749px) {
    .ai-size-guide-{{ ai_gen_id }} {
      padding: 24px 18px;
    }

    .ai-size-guide-{{ ai_gen_id }}__charts {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
{% endstyle %}

<size-guide-charts-{{ ai_gen_id }} class="ai-size-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-size-guide-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  {% if block.settings.intro != blank %}
    <p class="ai-size-guide-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>
  {% endif %}

  <div class="ai-size-guide-{{ ai_gen_id }}__charts">
    {% for chart_index in (1..6) %}
      {% liquid
        assign title_key = 'chart_' | append: chart_index | append: '_title'
        assign rows_key = 'chart_' | append: chart_index | append: '_rows'
        assign chart_title = block.settings[title_key]
        assign chart_rows = block.settings[rows_key] | newline_to_br | split: '<br />'
      %}
      {% if chart_title != blank %}
        <section class="ai-size-guide-{{ ai_gen_id }}__chart">
          <h3 class="ai-size-guide-{{ ai_gen_id }}__chart-title">{{ chart_title | escape }}</h3>
          {% for row in chart_rows %}
            {% assign parts = row | split: '|' %}
            {% assign row_name = parts[0] | strip %}
            {% assign row_value = parts[1] | strip %}
            {% assign bar_width = parts[2] | strip | default: 50 %}
            {% if row_name != blank and row_value != blank %}
              <div class="ai-size-guide-{{ ai_gen_id }}__row">
                <span class="ai-size-guide-{{ ai_gen_id }}__row-name">{{ row_name | escape }}</span>
                <span class="ai-size-guide-{{ ai_gen_id }}__track" aria-hidden="true"><span class="ai-size-guide-{{ ai_gen_id }}__fill" style="--bar-width: {{ bar_width }}%;"></span></span>
                <span class="ai-size-guide-{{ ai_gen_id }}__value">{{ row_value | escape }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </section>
      {% endif %}
    {% endfor %}
  </div>
</size-guide-charts-{{ ai_gen_id }}>

<script>
  (function() {
    class SizeGuideCharts{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.querySelectorAll('[aria-hidden="true"]').forEach((track) => {
          track.setAttribute('role', 'img');
        });
      }
    }
    if (!customElements.get('size-guide-charts-{{ ai_gen_id }}')) {
      customElements.define('size-guide-charts-{{ ai_gen_id }}', SizeGuideCharts{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Size guide charts",
  "tag": null,
  "class": "size-guide-charts-block",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Atelier size guide"},
    {"type":"textarea","id":"intro","label":"Intro","default":"Use the measurements below as a guide for your best fit."},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"header","content":"Chart content"},
    {"type":"text","id":"chart_1_title","label":"Chart 1 title","default":"Cup volume"},
    {"type":"textarea","id":"chart_1_rows","label":"Chart 1 rows","default":"A | 75 cm³ | 25\nB | 105 cm³ | 42\nC | 135 cm³ | 60\nD | 165 cm³ | 78"},
    {"type":"text","id":"chart_2_title","label":"Chart 2 title","default":"Band measurements"},
    {"type":"textarea","id":"chart_2_rows","label":"Chart 2 rows","default":"XS | 65 cm | 25\nS | 70 cm | 42\nM | 75 cm | 60\nL | 80 cm | 78"},
    {"type":"text","id":"chart_3_title","label":"Chart 3 title","default":"Body range"},
    {"type":"textarea","id":"chart_3_rows","label":"Chart 3 rows","default":"Petite | 150–160 cm | 35\nRegular | 161–170 cm | 55\nTall | 171–180 cm | 75"},
    {"type":"text","id":"chart_4_title","label":"Chart 4 title","default":"Corset reduction"},
    {"type":"textarea","id":"chart_4_rows","label":"Chart 4 rows","default":"Light | 2–4 cm | 25\nMedium | 5–7 cm | 50\nFirm | 8–10 cm | 78"},
    {"type":"text","id":"chart_5_title","label":"Chart 5 title","default":"Hosiery"},
    {"type":"textarea","id":"chart_5_rows","label":"Chart 5 rows","default":"S | 150–165 cm | 35\nM | 160–175 cm | 55\nL | 170–185 cm | 75"},
    {"type":"text","id":"chart_6_title","label":"Chart 6 title","default":"Gown length"},
    {"type":"textarea","id":"chart_6_rows","label":"Chart 6 rows","default":"Short | 135 cm | 35\nMidi | 145 cm | 58\nFull | 155 cm | 82"},
    {"type":"header","content":"Chart style"},
    {"type":"color","id":"background_color","label":"Background","default":"#161114"},
    {"type":"color","id":"heading_color","label":"Headings and values","default":"#f4efe6"},
    {"type":"color","id":"text_color","label":"Text","default":"#f4efe6"},
    {"type":"color","id":"muted_color","label":"Muted text","default":"#b7a792"},
    {"type":"color","id":"bar_color","label":"Bars","default":"#d4b06a"},
    {"type":"color","id":"track_color","label":"Bar tracks","default":"#3a2d32"},
    {"type":"color","id":"border_color","label":"Border","default":"#3a2d32"}
  ],
  "presets": [{"name":"Size guide charts"}]
}
{% endschema %}