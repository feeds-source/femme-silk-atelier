{% assign kicker = section.settings.kicker | default: 'Atelier fittings' %}
{% assign title = section.settings.title | default: 'Size charts and fit studio' %}
{% assign lede = section.settings.lede | default: 'Find your precise measurements from the tape, then explore the house maps — bra cups, body ranges, corset reduction, hosiery, and silk gowns.' %}

<section class="page-hero cine-page">
  <img class="ken" src="{{ 'measure-front.jpg' | asset_url }}" alt="{{ title | escape }}" width="1600" height="1000" loading="eager">
  <div class="hero-veil"></div>
  <div class="wrap page-hero-copy">
    <p class="kicker">{{ kicker }}</p>
    <h1 class="display page-title">{{ title }}</h1>
    <p class="muted lede">{{ lede }}</p>
    {% if section.settings.show_print_button != false %}
      <button type="button" class="btn" style="margin-top:1.25rem" onclick="window.print()">Print size charts</button>
    {% endif %}
  </div>
</section>

<nav class="guide-nav">
  <div class="wrap">
    <a class="pill" href="#finder">Find size</a>
    <a class="pill" href="#visuals">Visual charts</a>
    <a class="pill" href="#convert">Convert</a>
    <a class="pill" href="#bras">Band + cup</a>
    <a class="pill" href="#body">XS–XXL</a>
    <a class="pill" href="#night">Night</a>
    <a class="pill" href="#gowns">Gowns</a>
    <a class="pill" href="#corset">Corsetry</a>
    <a class="pill" href="#hose">Hosiery</a>
    <a class="pill" href="#swim">Swim</a>
    <a class="pill" href="#free">One cut</a>
  </div>
</nav>

<div class="wrap section" id="finder">
  <p class="kicker">Fit lab</p>
  <h2 class="display" style="font-style:italic;margin:0.5rem 0 0">Find your size</h2>
  <p class="muted" style="max-width:32rem;margin-top:0.75rem">Underbust and bust give the bra. Waist and hip vote on body, nighty, gown, and corset. Height and thigh set the hose.</p>
  <form class="fit-lab" data-fit>
    <div class="fit-units" data-fit-units>
      <button type="button" class="pill is-on" data-unit="cm">cm</button>
      <button type="button" class="pill" data-unit="in">in</button>
    </div>
    <div class="fit-grid">
      <label>Underbust <input type="number" min="0" step="0.5" name="under" inputmode="decimal"></label>
      <label>Bust <input type="number" min="0" step="0.5" name="bust" inputmode="decimal"></label>
      <label>Waist <input type="number" min="0" step="0.5" name="waist" inputmode="decimal"></label>
      <label>Hip <input type="number" min="0" step="0.5" name="hip" inputmode="decimal"></label>
      <label>Height <input type="number" min="0" step="0.5" name="height" inputmode="decimal"></label>
      <label>Thigh <input type="number" min="0" step="0.5" name="thigh" inputmode="decimal"></label>
    </div>
    <p class="subtle" data-fit-hint>Enter underbust and bust for a bra; waist and hip for body; height for hose.</p>
    <ul class="fit-out" data-fit-out hidden></ul>
  </form>
</div>

<div class="wrap section" id="visuals">
  <p class="kicker">Visual charts</p>
  <h2 class="display" style="font-style:italic;margin:0.5rem 0 0">Where the tape sits</h2>
  <div class="measure-grid">
    <figure class="measure-fig">
      <img src="{{ 'measure-front.jpg' | asset_url }}" alt="Front: where the tape sits" width="1152" height="1728" loading="lazy">
      <div class="measure-mark" style="top:38%"><div class="gold-rule"></div><span>Bust</span></div>
      <div class="measure-mark" style="top:44%"><div class="gold-rule"></div><span>Underbust</span></div>
      <div class="measure-mark" style="top:51%"><div class="gold-rule"></div><span>Waist</span></div>
      <div class="measure-mark" style="top:63%"><div class="gold-rule"></div><span>Hip</span></div>
      <figcaption>Front: where the tape sits</figcaption>
    </figure>
    <figure class="measure-fig">
      <img src="{{ 'measure-side.jpg' | asset_url }}" alt="Side: bust, waist, hip" width="1152" height="1728" loading="lazy">
      <div class="measure-mark" style="top:38%"><div class="gold-rule"></div><span>Bust</span></div>
      <div class="measure-mark" style="top:44%"><div class="gold-rule"></div><span>Underbust</span></div>
      <div class="measure-mark" style="top:51%"><div class="gold-rule"></div><span>Waist</span></div>
      <div class="measure-mark" style="top:63%"><div class="gold-rule"></div><span>Hip</span></div>
      <figcaption>Side: bust, waist, hip</figcaption>
    </figure>
  </div>

  <p class="kicker" style="margin-top:3.5rem">Cups we cut</p>
  <h2 class="display" style="font-style:italic;margin:0.5rem 0 0">Bra map</h2>
  <div class="bra-heat">
    <div class="lab"></div><div class="lab">A</div><div class="lab">B</div><div class="lab">C</div><div class="lab">D</div>
    <div class="lab">30</div>
    <div class="heat-off">—</div><div class="heat-on">30B</div><div class="heat-off">—</div><div class="heat-off">—</div>
    <div class="lab">32</div>
    <div class="heat-on">32A</div><div class="heat-on">32B</div><div class="heat-on">32C</div><div class="heat-on">32D</div>
    <div class="lab">34</div>
    <div class="heat-on">34A</div><div class="heat-on">34B</div><div class="heat-on">34C</div><div class="heat-on">34D</div>
    <div class="lab">36</div>
    <div class="heat-off">—</div><div class="heat-on">36B</div><div class="heat-on">36C</div><div class="heat-on">36D</div>
    <div class="lab">38</div>
    <div class="heat-off">—</div><div class="heat-on">38B</div><div class="heat-on">38C</div><div class="heat-on">38D</div>
    <div class="lab">40</div>
    <div class="heat-off">—</div><div class="heat-on">40B</div><div class="heat-on">40C</div><div class="heat-off">—</div>
    <div class="lab">42</div>
    <div class="heat-off">—</div><div class="heat-on">42B</div><div class="heat-on">42C</div><div class="heat-off">—</div>
  </div>

  <div class="bars">
    <article>
      <p class="kicker">Cup volume · bust minus band</p>
      {% assign cups = "A:59:12–14 cm:4.7–5.5 in:1″ gap,B:68:14–16 cm:5.5–6.3 in:2″ gap,C:77:16–18 cm:6.3–7.1 in:3″ gap,D:86:18–20 cm:7.1–7.9 in:4″ gap" | split: "," %}
      {% for c in cups %}
        {% assign p = c | split: ":" %}
        <div class="bar-row">
          <span class="bar-label">{{ p[0] }}</span>
          <div class="bar-track"><div class="bar-fill" style="width:{{ p[1] }}%"></div></div>
          <span class="subtle bar-value"><strong>{{ p[2] }}</strong> <small>({{ p[3] }})</small></span>
        </div>
      {% endfor %}
    </article>

    <article>
      <p class="kicker">Band · underbust measurement</p>
      {% assign bands = "30:18:63–67 cm:25–26.5 in,32:29:68–72 cm:27–28.5 in,34:43:73–77 cm:29–30.5 in,36:57:78–82 cm:31–32.5 in,38:71:83–87 cm:33–34.5 in,40:86:88–92 cm:35–36.5 in,42:100:93–97 cm:37–38.5 in" | split: "," %}
      {% for b in bands %}
        {% assign p = b | split: ":" %}
        <div class="bar-row">
          <span class="bar-label">{{ p[0] }}</span>
          <div class="bar-track"><div class="bar-fill blush" style="width:{{ p[1] }}%"></div></div>
          <span class="subtle bar-value"><strong>{{ p[2] }}</strong> <small>({{ p[3] }})</small></span>
        </div>
      {% endfor %}
    </article>
  </div>

  <p class="kicker" style="margin-top:3.5rem">XS to XXL</p>
  <h2 class="display" style="font-style:italic;margin:0.5rem 0 0">Body ranges</h2>
  <div class="range-chart">
    <p class="kicker">Bust · waist · hip with exact measurements</p>
    
    <div class="range-card">
      <div class="range-head">
        <span class="pill is-on">XS</span>
        <div class="range-specs">
          <span class="spec-item"><b style="background:var(--accent)"></b>Bust: <strong>78–82 cm</strong> <small>(30.5–32.5″)</small></span>
          <span class="spec-item"><b style="background:var(--blush)"></b>Waist: <strong>60–64 cm</strong> <small>(23.5–25″)</small></span>
          <span class="spec-item"><b style="background:var(--muted)"></b>Hip: <strong>86–90 cm</strong> <small>(34–35.5″)</small></span>
        </div>
      </div>
      <div class="range-track">
        <i class="bust" style="left:32.9%;width:5.7%" title="Bust 78–82 cm"></i>
        <i class="waist" style="left:7.1%;width:5.7%" title="Waist 60–64 cm"></i>
        <i class="hip" style="left:44.3%;width:5.7%" title="Hip 86–90 cm"></i>
      </div>
    </div>

    <div class="range-card">
      <div class="range-head">
        <span class="pill is-on">S</span>
        <div class="range-specs">
          <span class="spec-item"><b style="background:var(--accent)"></b>Bust: <strong>83–87 cm</strong> <small>(32.5–34.5″)</small></span>
          <span class="spec-item"><b style="background:var(--blush)"></b>Waist: <strong>65–69 cm</strong> <small>(25.5–27″)</small></span>
          <span class="spec-item"><b style="background:var(--muted)"></b>Hip: <strong>91–95 cm</strong> <small>(36–37.5″)</small></span>
        </div>
      </div>
      <div class="range-track">
        <i class="bust" style="left:40%;width:5.7%" title="Bust 83–87 cm"></i>
        <i class="waist" style="left:14.3%;width:5.7%" title="Waist 65–69 cm"></i>
        <i class="hip" style="left:51.4%;width:5.7%" title="Hip 91–95 cm"></i>
      </div>
    </div>

    <div class="range-card">
      <div class="range-head">
        <span class="pill is-on">M</span>
        <div class="range-specs">
          <span class="spec-item"><b style="background:var(--accent)"></b>Bust: <strong>88–92 cm</strong> <small>(34.5–36″)</small></span>
          <span class="spec-item"><b style="background:var(--blush)"></b>Waist: <strong>70–74 cm</strong> <small>(27.5–29″)</small></span>
          <span class="spec-item"><b style="background:var(--muted)"></b>Hip: <strong>96–100 cm</strong> <small>(38–39.5″)</small></span>
        </div>
      </div>
      <div class="range-track">
        <i class="bust" style="left:47.1%;width:5.7%" title="Bust 88–92 cm"></i>
        <i class="waist" style="left:21.4%;width:5.7%" title="Waist 70–74 cm"></i>
        <i class="hip" style="left:58.6%;width:5.7%" title="Hip 96–100 cm"></i>
      </div>
    </div>

    <div class="range-card">
      <div class="range-head">
        <span class="pill is-on">L</span>
        <div class="range-specs">
          <span class="spec-item"><b style="background:var(--accent)"></b>Bust: <strong>93–97 cm</strong> <small>(36.5–38″)</small></span>
          <span class="spec-item"><b style="background:var(--blush)"></b>Waist: <strong>75–79 cm</strong> <small>(29.5–31″)</small></span>
          <span class="spec-item"><b style="background:var(--muted)"></b>Hip: <strong>101–105 cm</strong> <small>(40–41.5″)</small></span>
        </div>
      </div>
      <div class="range-track">
        <i class="bust" style="left:54.3%;width:5.7%" title="Bust 93–97 cm"></i>
        <i class="waist" style="left:28.6%;width:5.7%" title="Waist 75–79 cm"></i>
        <i class="hip" style="left:65.7%;width:5.7%" title="Hip 101–105 cm"></i>
      </div>
    </div>

    <div class="range-card">
      <div class="range-head">
        <span class="pill is-on">XL</span>
        <div class="range-specs">
          <span class="spec-item"><b style="background:var(--accent)"></b>Bust: <strong>98–104 cm</strong> <small>(38.5–41″)</small></span>
          <span class="spec-item"><b style="background:var(--blush)"></b>Waist: <strong>80–86 cm</strong> <small>(31.5–34″)</small></span>
          <span class="spec-item"><b style="background:var(--muted)"></b>Hip: <strong>106–112 cm</strong> <small>(41.5–44″)</small></span>
        </div>
      </div>
      <div class="range-track">
        <i class="bust" style="left:61.4%;width:8.6%" title="Bust 98–104 cm"></i>
        <i class="waist" style="left:35.7%;width:8.6%" title="Waist 80–86 cm"></i>
        <i class="hip" style="left:72.9%;width:8.6%" title="Hip 106–112 cm"></i>
      </div>
    </div>

    <div class="range-card">
      <div class="range-head">
        <span class="pill is-on">XXL</span>
        <div class="range-specs">
          <span class="spec-item"><b style="background:var(--accent)"></b>Bust: <strong>105–112 cm</strong> <small>(41.5–44″)</small></span>
          <span class="spec-item"><b style="background:var(--blush)"></b>Waist: <strong>87–94 cm</strong> <small>(34.5–37″)</small></span>
          <span class="spec-item"><b style="background:var(--muted)"></b>Hip: <strong>113–120 cm</strong> <small>(44.5–47″)</small></span>
        </div>
      </div>
      <div class="range-track">
        <i class="bust" style="left:71.4%;width:10%" title="Bust 105–112 cm"></i>
        <i class="waist" style="left:45.7%;width:10%" title="Waist 87–94 cm"></i>
        <i class="hip" style="left:82.9%;width:10%" title="Hip 113–120 cm"></i>
      </div>
    </div>

    <p class="range-legend">
      <span><b style="background:var(--accent)"></b>Bust (Gold)</span>
      <span><b style="background:var(--blush)"></b>Waist (Blush)</span>
      <span><b style="background:var(--muted)"></b>Hip (Muted)</span>
    </p>
  </div>

  <div class="bars" style="margin-top:2rem">
    <article>
      <p class="kicker">Size progression · midpoints cm</p>
      {% assign mids = "XS:36:22:44:80 cm:62 cm:88 cm,S:43:27:51:85 cm:67 cm:93 cm,M:50:31:59:90 cm:72 cm:98 cm,L:57:36:66:95 cm:77 cm:103 cm,XL:66:43:74:101 cm:83 cm:109 cm,XXL:76:51:84:108.5 cm:90.5 cm:116.5 cm" | split: "," %}
      {% for row in mids %}
        {% assign p = row | split: ":" %}
        <div class="bar-row" style="margin-top:1.25rem">
          <span class="bar-label">{{ p[0] }}</span>
          <div class="bar-track stacked">
            <div class="bar-fill" style="width:{{ p[1] }}%"></div>
          </div>
          <span class="subtle bar-value"><strong style="color:var(--accent)">Bust {{ p[4] }}</strong></span>
        </div>
        <div class="bar-row" style="margin-top:0.35rem">
          <span class="bar-label"></span>
          <div class="bar-track stacked">
            <div class="bar-fill blush" style="width:{{ p[2] }}%"></div>
          </div>
          <span class="subtle bar-value"><strong style="color:var(--blush)">Waist {{ p[5] }}</strong></span>
        </div>
        <div class="bar-row" style="margin-top:0.35rem;margin-bottom:0.75rem">
          <span class="bar-label"></span>
          <div class="bar-track stacked">
            <div class="bar-fill muted" style="width:{{ p[3] }}%"></div>
          </div>
          <span class="subtle bar-value"><strong style="color:var(--muted)">Hip {{ p[6] }}</strong></span>
        </div>
      {% endfor %}
      <p class="range-legend" style="margin-top:0.75rem">
        <span><b style="background:var(--accent)"></b>Bust midpoint</span>
        <span><b style="background:var(--blush)"></b>Waist midpoint</span>
        <span><b style="background:var(--muted)"></b>Hip midpoint</span>
      </p>
    </article>

    <article>
      <p class="kicker">Nighties & Babydolls · length</p>
      {% assign nl = "S:82 cm:32.3 in:70:Short hem,M:84 cm:33.1 in:78:House default,L:86 cm:33.9 in:86:Ease through hip,XL:88 cm:34.6 in:94:Longer strap drop" | split: "," %}
      {% for c in nl %}
        {% assign p = c | split: ":" %}
        <div class="bar-row" style="margin-top:1rem">
          <span class="bar-label">{{ p[0] }}</span>
          <div class="bar-track"><div class="bar-fill" style="width:{{ p[3] }}%"></div></div>
          <span class="subtle bar-value"><strong>{{ p[1] }}</strong> <small>({{ p[2] }})</small></span>
        </div>
        <p class="subtle" style="font-size:0.75rem;padding-left:3.35rem;margin-top:0.15rem;color:var(--muted)">↳ {{ p[4] }}</p>
      {% endfor %}
    </article>
  </div>
</div>

<div class="wrap section" id="convert">
  <p class="kicker">UK · US · EU · FR · IT · AU · PK</p>
  <h2 class="display" style="font-style:italic;margin:0.5rem 0 0">International conversion</h2>
  <p class="muted" style="max-width:32rem;margin-top:0.75rem">House labels are UK/US band and XS–XXL. Match a label from another market here before you order.</p>
  
  <div class="range-chart">
    <p class="kicker">Dress numbers comparison</p>
    {% assign dress = "XS:10:4:33:UK 4–6:US 0–2:EU 32–34,S:18:10:37:UK 8–10:US 4–6:EU 36–38,M:26:18:41:UK 12–14:US 8–10:EU 40–42,L:34:26:45:UK 16–18:US 12–14:EU 44–46,XL:42:34:49:UK 20–22:US 16–18:EU 48–50,XXL:50:42:53:UK 24–26:US 20–22:EU 52–54" | split: "," %}
    {% for row in dress %}
      {% assign p = row | split: ":" %}
      <div class="range-card">
        <div class="range-head">
          <span class="pill is-on">{{ p[0] }}</span>
          <div class="range-specs">
            <span class="spec-item"><b style="background:var(--accent)"></b><strong>{{ p[4] }}</strong></span>
            <span class="spec-item"><b style="background:var(--blush)"></b><strong>{{ p[5] }}</strong></span>
            <span class="spec-item"><b style="background:var(--muted)"></b><strong>{{ p[6] }}</strong></span>
          </div>
        </div>
        <div class="range-track">
          <i class="bust" style="left:0;width:{{ p[1] }}%"></i>
          <i class="waist" style="left:0;width:{{ p[2] }}%"></i>
          <i class="hip" style="left:0;width:{{ p[3] }}%"></i>
        </div>
      </div>
    {% endfor %}
    <p class="range-legend">
      <span><b style="background:var(--accent)"></b>UK standard</span>
      <span><b style="background:var(--blush)"></b>US standard</span>
      <span><b style="background:var(--muted)"></b>EU standard</span>
    </p>
  </div>

  <div style="overflow-x:auto;margin-top:2rem">
    <table class="chart-table">
      <thead><tr><th>UK / US</th><th>EU</th><th>FR / ES / BE</th><th>IT</th><th>AU / NZ</th><th>PK</th></tr></thead>
      <tbody>
        <tr><td>30</td><td>65</td><td>80</td><td>0</td><td>8</td><td>30</td></tr>
        <tr><td>32</td><td>70</td><td>85</td><td>1</td><td>10</td><td>32</td></tr>
        <tr><td>34</td><td>75</td><td>90</td><td>2</td><td>12</td><td>34</td></tr>
        <tr><td>36</td><td>80</td><td>95</td><td>3</td><td>14</td><td>36</td></tr>
        <tr><td>38</td><td>85</td><td>100</td><td>4</td><td>16</td><td>38</td></tr>
        <tr><td>40</td><td>90</td><td>105</td><td>5</td><td>18</td><td>40</td></tr>
        <tr><td>42</td><td>95</td><td>110</td><td>6</td><td>20</td><td>42</td></tr>
      </tbody>
    </table>
  </div>

  <p class="kicker" style="margin-top:2.5rem">Cup mapping</p>
  <div style="overflow-x:auto">
    <table class="chart-table">
      <thead><tr><th>UK</th><th>US</th><th>EU</th><th>FR</th><th>Gap cm</th><th>Gap in</th></tr></thead>
      <tbody>
        <tr><td>A</td><td>A</td><td>A</td><td>A</td><td>12–14 cm</td><td>1 in</td></tr>
        <tr><td>B</td><td>B</td><td>B</td><td>B</td><td>14–16 cm</td><td>2 in</td></tr>
        <tr><td>C</td><td>C</td><td>C</td><td>C</td><td>16–18 cm</td><td>3 in</td></tr>
        <tr><td>D</td><td>D</td><td>D</td><td>D</td><td>18–20 cm</td><td>4 in</td></tr>
        <tr><td>DD</td><td>DD / E</td><td>E</td><td>E</td><td>20–22 cm</td><td>5 in</td></tr>
      </tbody>
    </table>
  </div>
  <p class="subtle" style="margin-top:0.75rem;font-size:0.85rem">DD and above are not cut in this house.</p>
</div>

<div class="wrap section">
  <section id="bras" class="scroll-pad">
    <p class="kicker">Band + cup</p>
    <h2 class="display" style="font-style:italic;margin:0.5rem 0 0">Bras & bridal sets</h2>
    <p class="muted" style="max-width:32rem;margin-top:0.75rem">Match underbust to the band, then the gap to the cup. Empty cells are not in this house.</p>
    <div style="overflow-x:auto">
      <table class="chart-table">
        <thead><tr><th>Size</th><th>Underbust cm</th><th>Underbust in</th><th>Bust cm</th><th>Bust in</th><th>EU</th><th>FR</th><th>Sisters</th></tr></thead>
        <tbody>
          <tr><td>30B</td><td>63–67</td><td>25–26.5</td><td>77–83</td><td>30.3–32.7</td><td>65</td><td>80</td><td>32A</td></tr>
          <tr><td>32A</td><td>68–72</td><td>27–28.5</td><td>80–86</td><td>31.5–33.9</td><td>70</td><td>85</td><td>30B</td></tr>
          <tr><td>32B</td><td>68–72</td><td>27–28.5</td><td>82–88</td><td>32.3–34.6</td><td>70</td><td>85</td><td>34A</td></tr>
          <tr><td>32C</td><td>68–72</td><td>27–28.5</td><td>84–90</td><td>33.1–35.4</td><td>70</td><td>85</td><td>34B</td></tr>
